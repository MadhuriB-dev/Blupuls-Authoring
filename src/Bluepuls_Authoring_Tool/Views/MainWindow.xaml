<Window x:Class="Bluepuls_Authoring_Tool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Bluepuls_Authoring_Tool.ViewModels"
        xmlns:views="clr-namespace:Bluepuls_Authoring_Tool.Views"
        mc:Ignorable="d"
        Title="Softing Diagnostic Tool Set - [Bluepuls Authoring Tool | ISO 22901-1/2 Interactive Editor]"
        Height="920" Width="1500"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>

        <Style x:Key="ModernDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1B365D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#2A4B7C"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Global DataGrid Virtualization & Container Recycling -->
        <Style TargetType="DataGrid">
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
        </Style>

        <!-- Single-click activation for virtualized TextBlock/ComboBox DataGridTemplateColumn cells -->
        <Style x:Key="FastComboCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,0"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="EditableComboCell_PreviewMouseLeftButtonDown"/>
        </Style>

        <!-- Lightweight single-Path TreeView Icon Style (replaces 18 stacked Shapes per row) -->
        <Style x:Key="TreeIconPathStyle" TargetType="Path">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Data" Value="M1,2 L5,2 L7,4 L13,4 L13,11 L1,11 Z"/>
            <Setter Property="Fill" Value="#E6C200"/>
            <Setter Property="Stroke" Value="#A68A00"/>
            <Setter Property="StrokeThickness" Value="0.8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NodeType}" Value="Container">
                    <Setter Property="Data" Value="M1,1 L9,1 L9,8 L1,8 Z M4,4 L12,4 L12,11 L4,11 Z"/>
                    <Setter Property="Fill" Value="#00B862"/>
                    <Setter Property="Stroke" Value="#005A30"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="BaseVariant">
                    <Setter Property="Data" Value="M 7,0 A 7,7 0 1 1 6.99,0 Z"/>
                    <Setter Property="Fill" Value="#D92525"/>
                    <Setter Property="Stroke" Value="#901515"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="EcuVariant">
                    <Setter Property="Data" Value="M 7,0 A 7,7 0 1 1 6.99,0 Z"/>
                    <Setter Property="Fill" Value="#0066CC"/>
                    <Setter Property="Stroke" Value="#004488"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="ProtocolNode">
                    <Setter Property="Data" Value="M 7,0 A 7,7 0 1 1 6.99,0 Z"/>
                    <Setter Property="Fill" Value="#117864"/>
                    <Setter Property="Stroke" Value="#0B5345"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="FunctionalGroupNode">
                    <Setter Property="Data" Value="M 7,0 A 7,7 0 1 1 6.99,0 Z"/>
                    <Setter Property="Fill" Value="#CA6F1E"/>
                    <Setter Property="Stroke" Value="#935116"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="VehicleFolder">
                    <Setter Property="Data" Value="M 7,0 A 7,7 0 1 1 6.99,0 Z"/>
                    <Setter Property="Fill" Value="#1B365D"/>
                    <Setter Property="Stroke" Value="#0D213D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="ServiceCurrentData">
                    <Setter Property="Data" Value="M2,10 L10,2 M4,2 L10,2 L10,8"/>
                    <Setter Property="Fill" Value="{x:Null}"/>
                    <Setter Property="Stroke" Value="#00A859"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="ServiceGreen">
                    <Setter Property="Data" Value="M2,10 L10,2 M4,2 L10,2 L10,8"/>
                    <Setter Property="Fill" Value="{x:Null}"/>
                    <Setter Property="Stroke" Value="#00A859"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="ServiceStoredData">
                    <Setter Property="Data" Value="M2,6 L10,6 M7,2 L11,6 L7,10"/>
                    <Setter Property="Fill" Value="{x:Null}"/>
                    <Setter Property="Stroke" Value="#D9822B"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="ServiceControl">
                    <Setter Property="Data" Value="M6,1 L11,6 L6,11 L1,6 Z"/>
                    <Setter Property="Fill" Value="#8A2BE2"/>
                    <Setter Property="Stroke" Value="#5A189A"/>
                    <Setter Property="StrokeThickness" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="DidNode">
                    <Setter Property="Data" Value="M2,2 L7,2 L11,6 L7,10 L2,10 Z"/>
                    <Setter Property="Fill" Value="#00B4D8"/>
                    <Setter Property="Stroke" Value="#0077B6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="DtcNode">
                    <Setter Property="Data" Value="M6,1 L11,10 L1,10 Z"/>
                    <Setter Property="Fill" Value="#FFB703"/>
                    <Setter Property="Stroke" Value="#D97706"/>
                    <Setter Property="StrokeThickness" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="LogicalLinkNode">
                    <Setter Property="Data" Value="M1,6 L11,6 M8,3 L11,6 L8,9"/>
                    <Setter Property="Fill" Value="{x:Null}"/>
                    <Setter Property="Stroke" Value="#1565C0"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="AblockNode">
                    <Setter Property="Data" Value="M1,1 L11,1 L11,11 L1,11 Z"/>
                    <Setter Property="Fill" Value="#6C3483"/>
                    <Setter Property="Stroke" Value="#4A235A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="ParentLinkNode">
                    <Setter Property="Data" Value="M2,2 L2,8 L10,8 M7,5 L10,8 L7,11"/>
                    <Setter Property="Fill" Value="{x:Null}"/>
                    <Setter Property="Stroke" Value="#2980B9"/>
                    <Setter Property="StrokeThickness" Value="1.8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="PatternNode">
                    <Setter Property="Data" Value="M 6,1 A 5,5 0 1 1 5.99,1 Z"/>
                    <Setter Property="Fill" Value="#EAFAF1"/>
                    <Setter Property="Stroke" Value="#27AE60"/>
                    <Setter Property="StrokeThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TreeBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,-0.5,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NodeType}" Value="BaseVariant">
                    <Setter Property="Text" Value="E"/>
                    <Setter Property="Foreground" Value="#FFFF00"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="EcuVariant">
                    <Setter Property="Text" Value="V"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="ProtocolNode">
                    <Setter Property="Text" Value="P"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="FunctionalGroupNode">
                    <Setter Property="Text" Value="F"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding NodeType}" Value="VehicleFolder">
                    <Setter Property="Text" Value="O"/>
                    <Setter Property="Foreground" Value="#7FB3D5"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#99A3A4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#1B365D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0E213D"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#0E6655"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B5345"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#B03A2E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#78281F"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#ECE9D8">
        <!-- Main Classic Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#ECE9D8" Padding="1" FontFamily="Tahoma" FontSize="11"
              IsEnabled="{Binding IsNotBusy}">
            <MenuItem Header="_File">
                <MenuItem Header="_New Authoring Project (Editable ISO ECU)..." Command="{Binding NewProjectCommand}"/>
                <MenuItem Header="_Open / Load PDX Archive (ISO 22901-2)..." Command="{Binding LoadPdxCommand}"/>
                <MenuItem Header="_Import Diagnostic File (ODX-D / ODX-C / ODX-V / XML)..." Command="{Binding ImportCommand}"/>
                <MenuItem Header="_Close / Clear Loaded Package" Command="{Binding ClearWorkspaceCommand}"/>
                <Separator/>
                <MenuItem Header="_Save / Export Package (.pdx / .odx-d / .xlsx / .csv)..." Command="{Binding ExportCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="_Authoring">
                <MenuItem Header="+ _Create New DID" Command="{Binding CreateDidCommand}"/>
                <MenuItem Header="+ _Create New DOP" Command="{Binding CreateDopCommand}"/>
                <MenuItem Header="+ _Create New Service" Command="{Binding CreateServiceCommand}"/>
                <MenuItem Header="+ _Create New DTC" Command="{Binding CreateDtcCommand}"/>
                <MenuItem Header="+ _Create New ComParam" Command="{Binding CreateComParamCommand}"/>
                <Separator/>
                <MenuItem Header="+ _Add ECU Variant" Command="{Binding AddEcuVariantCommand}"/>
                <MenuItem Header="+ _Add Base Variant" Command="{Binding AddBaseVariantCommand}"/>
            </MenuItem>
            <MenuItem Header="_Check">
                <MenuItem Header="_ISO 22901 Consistency Check" Command="{Binding ConsistencyCheckCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_New Project..." Command="{Binding NewProjectCommand}"/>
                <MenuItem Header="_Load PDX Package..." Command="{Binding LoadPdxCommand}"/>
                <MenuItem Header="_Save / Export..." Command="{Binding ExportCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar Tray -->
        <Border DockPanel.Dock="Top" Background="#ECE9D8" BorderBrush="#999999" BorderThickness="0,1,0,1" Padding="3,2"
                IsEnabled="{Binding IsNotBusy}">
            <StackPanel Orientation="Horizontal">
                <Button Height="24" Padding="7,0" Margin="1" ToolTip="Create a new editable ISO 22901 diagnostic workspace" Command="{Binding NewProjectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,2 L10,2 L13,5 L13,15 L3,15 Z" Fill="White" Stroke="#1B365D" StrokeThickness="1.2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="New Project" FontFamily="Tahoma" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Height="24" Padding="7,0" Margin="1" ToolTip="Load / Parse ISO 22901-2 PDX Diagnostic Package" Command="{Binding LoadPdxCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,4 L8,4 L10,6 L18,6 L18,16 L2,16 Z" Fill="#007ACC" Stroke="#005A9E" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Load PDX" FontFamily="Tahoma" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Height="24" Padding="7,0" Margin="1" ToolTip="Import ODX-D / ODX-C / ODX-V / XML File" Command="{Binding ImportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M7,1 L7,10 M4,7 L7,10 L10,7 M2,13 L12,13" Stroke="#0066CC" StrokeThickness="1.6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Import ODX" FontFamily="Tahoma" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Height="24" Padding="7,0" Margin="1" ToolTip="Save / Export edited package to .pdx, .odx-d, .xlsx, or .csv" Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M7,10 L7,1 M4,4 L7,1 L10,4 M2,13 L12,13" Stroke="#008A3E" StrokeThickness="1.6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Save / Export" FontFamily="Tahoma" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>

                <Button Height="24" Padding="7,0" Margin="1" ToolTip="Run ISO 22901 Cross-Reference &amp; Inheritance Check" Command="{Binding ConsistencyCheckCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,9 L7,13 L15,3" Stroke="#28A745" StrokeThickness="2.2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="ISO Check" FontFamily="Tahoma" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Height="24" Padding="7,0" Margin="1" ToolTip="Close Loaded Package &amp; Clear Workspace" Command="{Binding ClearWorkspaceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,3 L11,11 M11,3 L3,11" Stroke="#C0392B" StrokeThickness="1.8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Clear" FontFamily="Tahoma" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                <TextBlock Text=" PDX / ODX: " VerticalAlignment="Center" FontFamily="Tahoma" FontSize="11" FontWeight="Bold"/>
                <ComboBox ItemsSource="{Binding OdxProjects}" SelectedItem="{Binding SelectedOdxProject, Mode=TwoWay}" Width="185" Height="22" FontFamily="Tahoma" FontSize="11"/>

                <TextBlock Text=" Active Layer / Variant: " VerticalAlignment="Center" FontFamily="Tahoma" FontSize="11" FontWeight="Bold" Margin="6,0,0,0"/>
                <ComboBox ItemsSource="{Binding EcuList}" SelectedItem="{Binding SelectedEcu, Mode=TwoWay}" Width="210" Height="22" FontFamily="Tahoma" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Non-blocking Background Progress Indicator Banner -->
        <Border DockPanel.Dock="Top" Background="#D6EAF8" BorderBrush="#85C1E9" BorderThickness="0,0,0,1" Padding="8,4"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="180" Height="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding BusyMessage}" FontFamily="Tahoma" FontSize="11" FontWeight="Bold" Foreground="#1B4F72" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Live Authoring Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#E2E7ED" BorderBrush="#999999" BorderThickness="0,1,0,0" FontFamily="Tahoma" FontSize="11">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="#1B365D"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Workspace Area -->
        <Grid Margin="2" IsEnabled="{Binding IsNotBusy}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="540"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: ISO 22901 Diagnostic Layer Containers (DLC) Virtualized TreeView -->
            <Border Grid.Column="0" Background="White" BorderBrush="#999999" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#E2E7ED" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="6,4">
                        <TextBlock Text="ISO 22901-1 / 22901-2 DIAGNOSTIC LAYER CONTAINERS" FontFamily="Tahoma" FontSize="10" FontWeight="Bold" Foreground="#333333"/>
                    </Border>

                    <Grid>
                        <TreeView ItemsSource="{Binding DiagnosticTreeNodes}"
                                  SelectedItemChanged="TreeView_SelectedItemChanged"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="True"
                                  BorderThickness="0" Padding="3" FontFamily="Tahoma" FontSize="11">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="1,2"/>
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="1,1">
                                        <Grid Width="14" Height="14" Margin="0,0,4,0">
                                            <Path Style="{StaticResource TreeIconPathStyle}"/>
                                            <TextBlock Style="{StaticResource TreeBadgeTextStyle}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontFamily="Tahoma" FontSize="11"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- Empty State Prompt -->
                        <StackPanel Visibility="{Binding IsPackageLoaded, Converter={StaticResource InverseBoolToVisConverter}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <TextBlock Text="No PDX / ODX Package Loaded" FontWeight="Bold" FontSize="12" Foreground="#555555" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click 'New Project', 'Load PDX', or 'Import ODX' above to author or edit ISO 22901 data." FontSize="11" Foreground="#777777" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#ECE9D8"/>

            <!-- RIGHT PANEL: Full Editable Authoring Workspace -->
            <Border Grid.Column="2" Background="White" BorderBrush="#999999" BorderThickness="1">
                <DockPanel>
                    <!-- Header Banner -->
                    <Border DockPanel.Dock="Top" Background="#1B365D" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ActiveWorkspaceTitle}" Foreground="White" FontFamily="Tahoma" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ActiveWorkspaceSubtitle}" Foreground="#A9CCE3" FontFamily="Tahoma" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0E6655" CornerRadius="3" Padding="6,2" Margin="2,0">
                                    <TextBlock Text="{Binding CurrentDataServicesCount, StringFormat='Current Data: {0}'}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#B7950B" CornerRadius="3" Padding="6,2" Margin="2,0">
                                    <TextBlock Text="{Binding StoredDataServicesCount, StringFormat='Stored Data: {0}'}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#1F618D" CornerRadius="3" Padding="6,2" Margin="2,0">
                                    <TextBlock Text="{Binding InheritedServicesCount, StringFormat='Inherited (ISO): {0}'}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <Border Background="#2C3E50" CornerRadius="3" Padding="6,2" Margin="2,0">
                                    <TextBlock Text="{Binding TotalServicesCount, StringFormat='Total Services: {0}'}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Workspace Tabs -->
                    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                BorderThickness="0,1,0,0" BorderBrush="#999999" FontFamily="Tahoma" FontSize="11">

                        <!-- TAB 1: DIAGNOSTIC SERVICES (ODX-D) - EDITABLE -->
                        <TabItem Header="Diagnostic Services (ODX-D)">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#F4F6F9" BorderBrush="#D5D8DC" BorderThickness="0,0,0,1" Padding="6,5">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="+ Create Service" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateServiceCommand}"/>
                                        <Button Content="Save Service Changes" Style="{StaticResource SuccessButtonStyle}" Command="{Binding ApplyServiceEditsCommand}"/>
                                        <Button Content="Delete Service" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteServiceCommand}"/>

                                        <Separator Width="12" Opacity="0"/>
                                        <TextBlock Text="Category:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <ComboBox ItemsSource="{Binding ServiceCategoryFilters}" SelectedItem="{Binding ServiceCategoryFilter, Mode=TwoWay}" Width="115" Height="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="Scope:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <ComboBox ItemsSource="{Binding ServiceScopeFilters}" SelectedItem="{Binding ServiceScopeFilter, Mode=TwoWay}" Width="135" Height="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="Search:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding ServiceSearchText, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="22" VerticalContentAlignment="Center" Padding="4,0"/>
                                    </WrapPanel>
                                </Border>

                                <DataGrid ItemsSource="{Binding LayerServices}"
                                          SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#E0E0E0"
                                          VerticalGridLinesBrush="#E0E0E0"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                                          RowHeight="26">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Category" Width="115" CellStyle="{StaticResource FastComboCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DataCategory}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.ServiceCategoryOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding DataCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Height="22"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="SID" Binding="{Binding ServiceIdHex}" Width="60"/>
                                        <DataGridTextColumn Header="Service Name" Binding="{Binding ShortName}" Width="230"/>
                                        <DataGridTextColumn Header="ISO Origin" Binding="{Binding InheritanceScope}" IsReadOnly="True" Width="165"/>
                                        <DataGridTemplateColumn Header="Addressing" Width="125" CellStyle="{StaticResource FastComboCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Addressing}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.AddressingOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Addressing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Height="22"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
