                                    </WrapPanel>
                                </Border>

                                <DataGrid ItemsSource="{Binding LayerDtcs}" SelectedItem="{Binding SelectedDtc, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" RowHeight="26">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Display Code" Binding="{Binding DisplayCode}" Width="100"/>
                                        <DataGridTextColumn Header="Hex Code" Binding="{Binding TroubleCodeHex}" Width="90"/>
                                        <DataGridTextColumn Header="FTB" Binding="{Binding FailureTypeByte}" Width="60"/>
                                        <DataGridTemplateColumn Header="Severity" Width="100" CellStyle="{StaticResource FastComboCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Severity}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.DtcSeverityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Severity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Height="22"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ISO Scope" Binding="{Binding InheritanceScope}" IsReadOnly="True" Width="160"/>
                                        <DataGridTextColumn Header="Fault Description" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <!-- TAB 6: PROTOCOLS & BUS TIMINGS (ODX-C) - EDITABLE -->
                        <TabItem Header="Protocols &amp; ComParams (ODX-C)">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#F4F6F9" BorderBrush="#D5D8DC" BorderThickness="0,0,0,1" Padding="6,5">
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="+ Add ComParam" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CreateComParamCommand}"/>
                                        <Button Content="Apply ComParam" Style="{StaticResource SuccessButtonStyle}" Command="{Binding ApplyComParamEditsCommand}"/>
                                        <Button Content="Delete ComParam" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteComParamCommand}"/>
                                        <Separator Width="10" Opacity="0"/>
                                        <TextBlock Text="Name:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding EditComParamName, UpdateSourceTrigger=PropertyChanged}" Width="135" Height="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="Value:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding EditComParamValue, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="Unit:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding EditComParamUnit, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="Desc:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding EditComParamDesc, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="22"/>
                                    </WrapPanel>
                                </Border>

                                <DataGrid ItemsSource="{Binding LayerComParams}" SelectedItem="{Binding SelectedComParam, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" RowHeight="24">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Parameter Name" Binding="{Binding Name}" Width="200"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="110"/>
                                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="140"/>
                                        <DataGridTextColumn Header="ISO Origin / Scope" Binding="{Binding InheritanceScope}" IsReadOnly="True" Width="170"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <!-- TAB 7: ISO 22901 CONNECTIONS, TOPOLOGY & LAYER AUTHORING (VIRTUALIZED STAR GRID) -->
                        <TabItem Header="ISO Connections &amp; Topology">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="1.2*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Layer Creation Bar -->
                                <Border Grid.Row="0" Background="#EAF2F8" BorderBrush="#AED6F1" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="New Layer Name:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1B365D" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding NewEcuLayerName, UpdateSourceTrigger=PropertyChanged}" Width="170" Height="22" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="+ Add ECU Variant" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddEcuVariantCommand}"/>
                                        <Button Content="+ Add Base Variant" Style="{StaticResource SuccessButtonStyle}" Command="{Binding AddBaseVariantCommand}"/>
                                        <Button Content="Delete Active Layer" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteActiveLayerCommand}"/>
                                    </WrapPanel>
                                </Border>

                                <!-- 1. PARENT-REFS Inheritance Connection Authoring -->
                                <DockPanel Grid.Row="1" Margin="0,2,0,4">
                                    <TextBlock Text="1. ISO 22901-1 Layer Inheritance Connections (PARENT-REFS)" FontWeight="Bold" Foreground="#1B365D" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ComboBox ItemsSource="{Binding AvailableTargetLayers}" SelectedItem="{Binding SelectedParentTargetLayer, Mode=TwoWay}" DisplayMemberPath="ShortName" Width="160" Height="22" Margin="0,0,4,0"/>
                                        <ComboBox ItemsSource="{Binding ParentRefTypeOptions}" SelectedItem="{Binding SelectedParentRefType, Mode=TwoWay}" Width="145" Height="22" Margin="0,0,4,0"/>
                                        <Button Content="+ Link Parent Layer" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddParentRefConnectionCommand}"/>
                                        <Button Content="Unlink Selected" Style="{StaticResource DangerButtonStyle}" Command="{Binding RemoveParentRefConnectionCommand}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding IsoConnections}" SelectedItem="{Binding SelectedIsoConnection, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" RowHeight="23" Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Child / Source Layer" Binding="{Binding SourceLayer}" Width="180"/>
                                        <DataGridTextColumn Header="Source Type" Binding="{Binding SourceType}" Width="115"/>
                                        <DataGridTextColumn Header="PARENT-REF Role" Binding="{Binding RelationType}" Width="150"/>
                                        <DataGridTextColumn Header="Target Parent Layer" Binding="{Binding TargetLayer}" Width="165"/>
                                        <DataGridTextColumn Header="Target Type" Binding="{Binding TargetType}" Width="105"/>
                                        <DataGridTextColumn Header="DOCREF Container" Binding="{Binding DocRefContainer}" Width="130"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                                        <DataGridTextColumn Header="Excluded" Binding="{Binding ExcludedItems}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 2. ODX-V Vehicle Logical Links -->
                                <TextBlock Grid.Row="3" Text="2. ISO 22901-1 Vehicle Topology &amp; Logical Links (ODX-V)" FontWeight="Bold" Foreground="#1B365D" Margin="0,2,0,4"/>
                                <DataGrid Grid.Row="4" ItemsSource="{Binding LogicalLinksView}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" RowHeight="23" Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Vehicle Model" Binding="{Binding VehicleModel}" Width="140"/>
                                        <DataGridTextColumn Header="Logical Link" Binding="{Binding LogicalLinkName}" Width="140"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150"/>
                                        <DataGridTextColumn Header="Physical Bus" Binding="{Binding PhysicalBus}" Width="130"/>
                                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="115"/>
                                        <DataGridTextColumn Header="BaseVariant" Binding="{Binding BaseVariant}" Width="150"/>
                                        <DataGridTextColumn Header="FunctionalGroup" Binding="{Binding FunctionalGroup}" Width="115"/>
                                        <DataGridTextColumn Header="Req ID" Binding="{Binding PhysicalReqId}" Width="70"/>
                                        <DataGridTextColumn Header="Resp ID" Binding="{Binding PhysicalRespId}" Width="70"/>
                                        <DataGridTextColumn Header="Func ID" Binding="{Binding FunctionalReqId}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 3. ECU Variant Identification Patterns Authoring -->
                                <DockPanel Grid.Row="5" Margin="0,2,0,4">
                                    <TextBlock Text="3. ECU Variant Identification Patterns (ECU-VARIANT-PATTERNS)" FontWeight="Bold" Foreground="#1B365D" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding NewPatternName, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="22" ToolTip="Pattern Name" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding NewPatternService, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="22" ToolTip="Service Name" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding NewPatternParam, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="22" ToolTip="Param Name" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding NewPatternExpectedValue, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="22" ToolTip="Expected Value" Margin="0,0,4,0"/>
                                        <Button Content="+ Add Pattern" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddVariantPatternCommand}"/>
                                        <Button Content="Delete Pattern" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteVariantPatternCommand}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid Grid.Row="6" ItemsSource="{Binding VariantPatternsView}" SelectedItem="{Binding SelectedVariantPattern, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" RowHeight="23" Margin="0,0,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ECU Variant" Binding="{Binding EcuVariant}" Width="200"/>
                                        <DataGridTextColumn Header="Pattern Name" Binding="{Binding PatternName}" Width="140"/>
                                        <DataGridTextColumn Header="Diagnostic Service (DIAG-COMM)" Binding="{Binding DiagService}" Width="230"/>
                                        <DataGridTextColumn Header="Response Parameter" Binding="{Binding ParameterName}" Width="150"/>
                                        <DataGridTextColumn Header="Expected Match Value" Binding="{Binding ExpectedValue}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 4. ISO Consistency Validation -->
                                <TextBlock Grid.Row="7" Text="4. ISO 22901 Cross-Reference Consistency Check" FontWeight="Bold" Foreground="#1B365D" Margin="0,2,0,4"/>
                                <DataGrid Grid.Row="8" ItemsSource="{Binding ConsistencyIssuesView}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" RowHeight="23">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                                        <DataGridTextColumn Header="ISO Rule" Binding="{Binding StandardRule}" Width="210"/>
                                        <DataGridTextColumn Header="Source Object" Binding="{Binding SourceObject}" Width="180"/>
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 8: PDX MANIFEST & ABLOCKS (ISO 22901-2) -->
                        <TabItem Header="PDX Manifest &amp; ABLOCKs">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="190"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Package Metadata (ISO 22901-2 CATALOG)" FontWeight="Bold" Foreground="#1B365D" Margin="0,0,0,4"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding PackageMetadata}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" RowHeight="24" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Property" Binding="{Binding Key}" Width="230" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2" Text="ISO 22901-2 Packaged Archive Blocks (ABLOCKS / index.xml)" FontWeight="Bold" Foreground="#1B365D" Margin="0,2,0,4"/>
                                <DataGrid Grid.Row="3" ItemsSource="{Binding AblockManifestRows}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" RowHeight="24">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ABLOCK Name" Binding="{Binding AblockName}" Width="200"/>
                                        <DataGridTextColumn Header="ISO Category" Binding="{Binding IsoCategory}" Width="155"/>
                                        <DataGridTextColumn Header="Archive Relative Path" Binding="{Binding RelativePath}" Width="240"/>
                                        <DataGridTextColumn Header="MIME Type" Binding="{Binding MimeType}" Width="180"/>
                                        <DataGridTextColumn Header="Size (Bytes)" Binding="{Binding FileSizeBytes}" Width="90"/>
                                        <DataGridTextColumn Header="Checksum" Binding="{Binding Checksum}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 9: COMMUNICATION & LINKING LOGS -->
                        <TabItem Header="Communication Logs">
                            <DataGrid ItemsSource="{Binding CommunicationLogs}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" RowHeight="22">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Width="90"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding Direction}" Width="55"/>
                                    <DataGridTextColumn Header="Service ID" Binding="{Binding ServiceId}" Width="80"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="350"/>
                                    <DataGridTextColumn Header="Raw PDU" Binding="{Binding RawData}" Width="120"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
